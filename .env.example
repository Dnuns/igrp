# Copy this file to ".env" and fill in your own values:
#
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (Linux/macOS)
#
# ".env" is listed in .gitignore and must NEVER be committed.
# On Linux/macOS, restrict its permissions with:  chmod 600 .env
#
# Leave IGRP_PASSWORD empty to be prompted at runtime instead of storing it
# on disk (the most secure option).

# --- Credentials ---------------------------------------------------------
IGRP_USERNAME=
IGRP_PASSWORD=

# --- Optional settings ---------------------------------------------------
# Login page. Change it if NOSi moves the portal again.
IGRP_LOGIN_URL=https://nosiapps.gov.cv/redglobal/redglobal.glb_dispatcher.login

# Browser: firefox (default), chrome or edge.
IGRP_BROWSER=firefox

# Seconds to wait for each element.
IGRP_TIMEOUT=30

# Run the browser without a window (headless). Only useful to smoke-test the
# login; keep it false for normal use.
IGRP_HEADLESS=false

# --- Absences (menu option 2) -------------------------------------------
# Class (turma) to select, e.g. "7ªD" or its value "1-126106".
# Leave empty when the account has a single turma (it is picked automatically).
# When set, it also filters option 3 (grade template): use the full label,
# e.g. "7ª / D / FRA", or its code, e.g. "126106-793013".
IGRP_TURMA=

# Folder where the downloaded absence PDFs are saved.
IGRP_DOWNLOAD_DIR=downloads

# --- Grades (menu options 3 and 4) --------------------------------------
# Workbook(s) imported by option 4. Leave empty to be asked which of the
# newest "pautas_1T_*.xlsx", "pautas_2T_*.xlsx", "pautas_3T_*.xlsx" found
# in IGRP_DOWNLOAD_DIR to import (one file per trimester).
# Set a path to import that single workbook without asking.
IGRP_GRADES_FILE=

# Highest grade accepted on import. The Cape Verde scale is 0-20.
IGRP_NOTA_MAX=20

# Preview only: option 4 prints the changes but saves nothing.
IGRP_GRADES_DRY_RUN=false
